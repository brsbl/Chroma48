{
  "name": "chroma48",
  "version": "1.0.0",
  "description": "A 2048 Tetris-like game called Chroma48",
  "main": "script.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "build:css": "postcss src/styles/main.css -o app/style.css",
    "build:js": "node esbuild.config.js",
    "build": "npm run build:css && npm run build:js",
    "build:dev": "npm run build:css && node esbuild.config.js --dev",
    "watch:css": "postcss src/styles/main.css -o app/style.css --watch",
    "watch": "node esbuild.config.js --dev"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.18"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0"
  }
}
